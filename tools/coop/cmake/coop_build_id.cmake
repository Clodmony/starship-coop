# Writes the co-op build id (the git commit, "-dirty" with uncommitted changes) to a header, on every build.
#   cmake -DSRC=<repo> -DOUT=<header> -P coop_build_id.cmake
# The header is only rewritten when the id changes, so an unchanged tree does not recompile anything.
# A tree without git gets "unknown"; two such builds would count as the same build.

find_package(Git QUIET)
set(COOP_BUILD_ID "unknown")
if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" rev-parse --short=12 HEAD
        OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE failed)
    if(NOT failed AND commit)
        set(COOP_BUILD_ID "${commit}")
        # Tracked files only: untracked files (local/, build output) do not change the game.
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" status --porcelain --untracked-files=no
            OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(changes)
            set(COOP_BUILD_ID "${COOP_BUILD_ID}-dirty")
        endif()
    endif()
endif()

set(content "#pragma once\n// Generated by tools/coop/cmake/coop_build_id.cmake on every build.\n#define COOP_BUILD_ID \"${COOP_BUILD_ID}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()
